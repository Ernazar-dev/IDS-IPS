# ==========================================
# IDS/IPS Pro — Master GitIgnore Config
# ==========================================

# Node.js dependencies
node_modules/
**/node_modules/
package-lock.json
**/package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and sensitive variables (NEVER commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env*.local

# SQLite local databases
*.db
*.sqlite
*.sqlite3
**/*.db
**/*.sqlite
**/*.sqlite3

# Production builds
dist/
**/dist/
build/
**/build/

# Python caching & execution files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc

# Python virtual environments (venv)
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
pip-log.txt
pip-delete-this-directory.txt

# Editor / IDE settings
.vscode/
**/ .vscode/
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db

# Antigravity / Gemini temporary files
.antigravitycli/
.gemini/